{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": ["index.ts"]
}
